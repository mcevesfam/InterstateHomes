# Database (Neon Postgres in US region; leave empty with DEMO_MODE=true for local UI preview)
DATABASE_URL=

# Security & Encryption (generate 32+ byte hex/base64 values in production)
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=replace-with-long-random-session-secret-in-production

# Local Preview Mode (true = use seeded in-memory store when DATABASE_URL is unset)
DEMO_MODE=true

# API & Web
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional Google SSO (Staff)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# US-Hosted S3 / Cloudflare R2 Storage
S3_ENDPOINT=
S3_REGION=us-west-2
S3_BUCKET=interstate-homes-docs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Self-Hosted DocuSeal E-Signature
DOCUSEAL_URL=http://localhost:3001
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=

# Outbound Email (@interstatehomes.com)
EMAIL_PROVIDER=console
EMAIL_FROM=estimating@interstatehomes.com
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=

# Closed-Loop Feedback AI & GitHub Issue Dispatch (Optional; deterministic fallbacks when unset)
GEMINI_API_KEY=
GEMINI_FEEDBACK_MODEL=gemini-2.5-flash
GITHUB_TOKEN=
GITHUB_REPO=mcevesfam/InterstateHomes
FEEDBACK_APPROVER_EMAIL=
